# Required
FRONTEND_DOMAIN=app.example.ru
BACKEND_ORIGIN=https://api.example.ru
CERTBOT_EMAIL=admin@example.ru

# Source and build
REPO_URL=https://github.com/Bambale0/banano_kling.git
REPO_BRANCH=tanyapi
SOURCE_DIR=/opt/banano-kling-src
RUN_NPM_AUDIT=1
FORCE_RESET_SOURCE=0
NODE_MAJOR=22

# Static deployment
WEB_ROOT=/var/www/app.example.ru
MINIAPP_ROOT=/var/www/app.example.ru/mini-app
BACKUP_ROOT=/var/backups/banano-miniapp/app.example.ru
KEEP_BACKUPS=7

# Nginx/proxy
BACKEND_HOST_HEADER=api.example.ru
CLIENT_MAX_BODY_SIZE=60M
PROXY_TIMEOUT_SECONDS=600
ENABLE_UFW=1
SKIP_TLS=0
SKIP_DNS_CHECK=0

# Optional: configure backend automatically through an existing SSH key.
# BACKEND_SSH_HOST=root@203.0.113.10
# BACKEND_PROJECT_DIR=/root/tanya/banano_kling
# BACKEND_ENV_FILE=/root/tanya/banano_kling/.env
# BACKEND_SERVICE=banano-kling.service
# BACKEND_PORT=1888
# CONFIGURE_BACKEND_UFW=1
