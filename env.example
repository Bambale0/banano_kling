BOT_TOKEN=

# Webhooks
WEBHOOK_HOST=
WEBHOOK_PATH=/webhook
WEBHOOK_PORT=8443

# Telegram Mini App
# Must be a public HTTPS URL configured in BotFather.
MINI_APP_URL=

# Admins
ADMIN_IDS=

# Database
DATABASE_PATH=bot.db
DATABASE_URL=sqlite:///bot.db
# PostgreSQL cutover values:
# POSTGRES_DB=banano_kling
# POSTGRES_USER=banano
# POSTGRES_PASSWORD=change-me
# POSTGRES_PORT=5432
# DATABASE_URL=postgresql://banano:change-me@127.0.0.1:5432/banano_kling
# Redis reliability backend:
# REDIS_URL=redis://127.0.0.1:6379/0

# Background push scenarios
PUSH_SCENARIOS_BACKGROUND_ENABLED=1
PUSH_SCENARIOS_INTERVAL_SECONDS=1800
PUSH_SCENARIOS_BATCH_LIMIT=10
PUSH_SCENARIOS_SEND_SLEEP_SECONDS=1.0
PUSH_SCENARIOS_USER_COOLDOWN_SECONDS=86400
PUSH_SCENARIOS_STARTUP_DELAY_SECONDS=60

# Payments
PAYMENT_PROVIDER=tbank
TBANK_TERMINAL_KEY=
TBANK_SECRET_KEY=
TBANK_API_URL=https://securepay.tinkoff.ru/v2/
TBANK_SUCCESS_URL=

CRYPTOBOT_API_TOKEN=
CRYPTOBOT_BASE_URL=https://pay.crypt.bot
CRYPTOBOT_ACCEPTED_ASSETS=USDT,TON,BTC,ETH,LTC,BNB,TRX,USDC
CRYPTOBOT_EXPIRES_IN=3600

# Jump Finance payouts for partners
JUMP_FINANCE_CLIENT_KEY=
JUMP_FINANCE_BASE_URL=https://api.jump.finance/services/openapi
JUMP_FINANCE_AGENT_ID=
JUMP_FINANCE_BANK_ACCOUNT_ID=
JUMP_FINANCE_PAYOUT_SERVICE_NAME=Партнерское вознаграждение
JUMP_FINANCE_PAYOUT_PURPOSE=Выплата партнерского вознаграждения
PARTNER_MIN_WITHDRAWAL_RUB=0
PARTNER_RUB_PER_CREDIT=10
PARTNER_OFFER_URL=
PARTNER_RULES_URL=

# AI providers
NANOBANANA_API_KEY=
FREEPIK_API_KEY=
NOVITA_API_KEY=
AI_WEBHOOK_SECRET=
KIE_AI_API_KEY=
KIE_AI_WEBHOOK_PATH=/webhook/kie_ai
