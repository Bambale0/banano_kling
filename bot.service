[Unit]
Description=Banano Kling Telegram Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/bot/banano_kling
ExecStart=/root/bot/banano_kling/scripts/run_bot_foreground.sh
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
