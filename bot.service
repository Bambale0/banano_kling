[Unit]
Description=banano_kling Telegram Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/banano_kling
EnvironmentFile=-/root/banano_kling/.env
ExecStart=/bin/bash -lc 'cd /root/banano_kling && source venv/bin/activate && exec python -m bot.main'
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=mixed

[Install]
WantedBy=multi-user.target
